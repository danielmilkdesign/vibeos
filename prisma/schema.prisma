datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMINISTRADOR
  GESTOR_COMERCIAL
  COMERCIAL
  OPERACOES
  DESIGN_CONTEUDO
  FINANCEIRO
}

enum LeadStatus {
  LEAD_NOVO
  DIAGNOSTICO_GERADO
  ABORDADO_EMAIL
  ABORDADO_WHATSAPP
  REUNIAO_AGENDADA
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

enum NichoEnum {
  ESTETICA
  ODONTOLOGIA
  PERSONAL_TRAINER
  MEDICINA
  ADVOCACIA
  OUTROS
}

enum UrgenciaEnum {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

enum ProposalStatus {
  RASCUNHO
  EM_REVISAO
  ENVIADA
  VISUALIZADA
  NEGOCIACAO
  APROVADA
  RECUSADA
  EXPIRADA
}

enum ProjectStatus {
  NAO_INICIADO
  ONBOARDING
  EM_PLANEJAMENTO
  EM_PRODUCAO
  AGUARDANDO_CLIENTE
  REVISAO_INTERNA
  EM_APROVACAO
  PUBLICACAO
  CONCLUIDO
  PAUSADO
}

enum RiskLevel {
  NORMAL
  ATENCAO
  CRITICO
}

enum ContractStatus {
  RASCUNHO
  EM_ASSINATURA
  ATIVO
  PAUSADO
  RENOVACAO_PROXIMA
  ENCERRADO
  CANCELADO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(COMERCIAL)
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id               String        @id @default(uuid())
  tradeName        String
  legalName        String?
  segment          NichoEnum     @default(OUTROS)
  subsegment       String?
  city             String        @default("Manaus")
  state            String        @default("AM")
  website          String?
  instagramUrl     String?
  googleProfileUrl String?
  status           String        @default("prospect")
  leads            Lead[]
  opportunities    Opportunity[]
  contracts        Contract[]
  projects         Project[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Lead {
  id              String        @id @default(uuid())
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  nomeEmpresa     String
  nicho           NichoEnum
  localizacao     String
  linkBio         String?
  status          LeadStatus    @default(LEAD_NOVO)
  urgencia        UrgenciaEnum  @default(ALTA)
  
  authorityScore  Int           @default(0)
  trafegoOrganico Int           @default(0)
  palavrasChave   Int           @default(0)
  percentSocial   Float         @default(100.0)
  diagnosticoSeo  String?

  nomeDecisor     String?
  cargoDecisor    String?
  emailDecisor    String?
  phoneWhatsapp   String?
  instagramUrl    String?
  valorEstimado   Float         @default(2000)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Opportunity {
  id                String      @id @default(uuid())
  companyId         String?
  company           Company?    @relation(fields: [companyId], references: [id])
  title             String
  offerName         String
  setupValue        Float       @default(0)
  recurringValue    Float       @default(0)
  estimatedValue    Float       @default(0)
  probability       Int         @default(20)
  stage             LeadStatus  @default(LEAD_NOVO)
  nextAction        String?
  nextActionDate    DateTime?
  ownerName         String      @default("Time Comercial")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Proposal {
  id             String         @id @default(uuid())
  proposalNumber String         @unique
  clientName     String
  clientEmail    String
  offerTitle     String
  setupValue     Float
  recurringValue Float
  validUntil     DateTime
  status         ProposalStatus @default(RASCUNHO)
  scopeText      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Project {
  id              String        @id @default(uuid())
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  name            String
  clientName      String
  nicho           NichoEnum     @default(OUTROS)
  projectType     String        @default("Presença Própria")
  status          ProjectStatus @default(BRIEFING)
  riskLevel       RiskLevel     @default(NORMAL)
  progress        Int           @default(0)
  totalValue      Float
  downPayment     Float
  slaDays         Int           @default(7)
  startDate       DateTime      @default(now())
  dueDate         DateTime
  checklistNorms  Boolean       @default(false)
  ownerName       String        @default("Operações VIBE")
  tasks           Task[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  assignedTo  String
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Contract {
  id             String         @id @default(uuid())
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  contractNumber String         @unique
  clientName     String
  offerName      String
  setupValue     Float          @default(0)
  recurringValue Float          @default(0)
  billingPeriod  String         @default("MENSAL")
  dueDay         Int            @default(10)
  deliveryLimit  Int            @default(5)
  status         ContractStatus @default(ATIVO)
  startDate      DateTime       @default(now())
  renewalDate    DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
