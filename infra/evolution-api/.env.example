# ============================================================================
# Evolution API (WhatsApp) — variáveis de ambiente
# Copie para `.env` e preencha os valores reais. NUNCA commite o `.env`.
# ============================================================================

# --- Autenticação da API (o "apikey" que o VibeOS envia no header) ---
# Gere um valor forte. Este mesmo valor vai em EVOLUTION_API_KEY no Vercel.
AUTHENTICATION_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
# URL pública do Evolution API (usada em webhooks). Em produção, o IP/domínio da VM.
SERVER_URL=https://SEU_DOMINIO_OU_IP:8080

# --- Postgres ---
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# --- Banco de dados (obrigatório no v2) ---
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROQUE_POR_UMA_SENHA_FORTE@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true

# --- Cache Redis ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false

# --- RabbitMQ (desligado na stack mínima) ---
RABBITMQ_ENABLED=false

# --- Flags úteis ---
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
