{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Vibe OS Design Tokens Manifest",
  "version": "1.0.0",
  "tokens": {
    "colors": {
      "brand": {
        "primary": "var(--color-brand-primary, #6366f1)",
        "secondary": "var(--color-brand-secondary, #a855f7)",
        "accent": "var(--color-brand-accent, #ec4899)"
      },
      "surface": {
        "base": "var(--color-surface-base, #0f172a)",
        "subtle": "var(--color-surface-subtle, #1e293b)",
        "elevated": "var(--color-surface-elevated, #334155)"
      },
      "text": {
        "main": "var(--color-text-main, #f8fafc)",
        "muted": "var(--color-text-muted, #94a3b8)",
        "inverse": "var(--color-text-inverse, #0f172a)"
      },
      "border": {
        "subtle": "var(--color-border-subtle, #334155)",
        "focus": "var(--color-border-focus, #6366f1)"
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem"
    },
    "radii": {
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "full": "9999px"
    }
  }
}
