# VIBE OS - Configurações de Ambiente
# Neon Postgres Connection URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Sessões assinadas: gerar segredo aleatório com pelo menos 32 bytes
NEXTAUTH_SECRET=""

# Webhook: segredo separado, com pelo menos 32 bytes
LEAD_WEBHOOK_SECRET=""

# Busca de empresas (somente no servidor)
SERPER_API_KEY=""

# AIsa Growth Engine (DataForSEO, Semrush, Apollo)
AISA_API_KEY=""

# VIBE OS Settings
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_WHATSAPP_OFFICIAL="5592992027059"

# Envio automático de WhatsApp via Evolution API (self-hosted, ≥2GB RAM)
# Deixe vazio para usar apenas o deep-link wa.me (envio manual).
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
